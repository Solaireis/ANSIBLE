; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL	86400
@	IN	SOA	WSS2023-LINUXHOST-001.wss2023.com. root.WSS2023-LINUXHOST-001.wss2023.com. (
			      1		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			  86400 )	; Negative Cache TTL
;
@	IN	NS	WSS2023-LINUXHOST-001.wss2023.com.
@	IN	PTR	WSS2023-LINUXHOST-001.wss2023.com.
10	IN	PTR	WSS2023-LINUXHOST-001.wss2023.com.
2	IN	PTR	WSS2023-LINUXHOST-002.wss2023.com.
3	IN	PTR	WSS2023-LINUXHOST-003.wss2023.com.

101	IN	PTR	WSS2023-DC-001.wss2023.com.
102	IN	PTR	WSS2023-HOST-002.wss2023.com.
103	IN	PTR	WSS2023-HOST-003.wss2023.com.
	
201	IN	PTR	wss2023-rtr1.wss2023.com.
202	IN	PTR	wss2023-rtr2.wss2023.com.
203	IN	PTR	wss2023-rtr3.wss2023.com.
204	IN	PTR	wss2023-rtr4.wss2023.com.

51	IN	PTR	intranet.wss2023.com.




